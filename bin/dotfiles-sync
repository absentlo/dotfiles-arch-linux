#!/usr/bin/env bash
# dotfiles-sync - copy the live configs into ~/dotfiles and show what changed.
# Commit yourself afterwards: git -C ~/dotfiles commit -am "..." && git -C ~/dotfiles push
set -e
D="$HOME/dotfiles"
C="$HOME/.config"

for dir in i3 polybar picom rofi dunst gtk-4.0 fastfetch btop zathura mpv gammastep fontconfig dircolors; do
    mkdir -p "$D/$dir"; cp -r "$C/$dir/." "$D/$dir/"
done
cp "$C/gtk-3.0/settings.ini" "$C/gtk-3.0/gtk.css" "$D/gtk-3.0/"   # not the whole dir: Thunar keeps private bookmarks there
mkdir -p "$D/pipewire" && cp -r "$C/pipewire/." "$D/pipewire/"
find "$HOME/.local/bin" -maxdepth 1 -type f -exec cp {} "$D/bin/" \;   # real files only: symlinks there are installed apps (claude)
cp "$C/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml" \
   "$HOME/.local/share/xfce4/terminal/colorschemes/graphite.theme" "$D/xfce4-terminal/"
mkdir -p "$D/backgrounds" && cp "$HOME"/.local/share/backgrounds/* "$D/backgrounds/"
cp "$C/greenclip.toml" "$D/home/"
mkdir -p "$D/thunar" && cp "$C/Thunar/uca.xml" "$D/thunar/"
mkdir -p "$D/krita" && cp "$HOME"/.local/share/krita/color-schemes/*.colors "$D/krita/"
mkdir -p "$D/gtksourceview-4" && cp "$HOME"/.local/share/gtksourceview-4/styles/*.xml "$D/gtksourceview-4/"
cp "$HOME/.bashrc" "$D/"
cp "$HOME/.bash_profile" "$HOME/.xinitrc" "$HOME/.fehbg" "$D/home/"
mkdir -p "$D/home/.icons/default" && cp "$HOME/.icons/default/index.theme" "$D/home/.icons/default/"   # X/i3 cursor theme
cp /etc/sysctl.d/99-rice.conf /etc/default/earlyoom /etc/systemd/zram-generator.conf "$D/system/"
cp /etc/default/grub "$D/system/grub"
cp /etc/issue "$D/system/issue"
cp "$C"/librewolf/librewolf/*.default-release/user.js "$D/librewolf/"
mkdir -p "$D/thunderbird" && cp "$C"/thunderbird/*.default-release/user.js "$D/thunderbird/"
mkdir -p "$D/thunderbird/chrome" && cp "$C"/thunderbird/*.default-release/chrome/*.css "$D/thunderbird/chrome/"
mkdir -p "$D/librewolf/chrome" && cp "$C"/librewolf/librewolf/*.default-release/chrome/*.css "$D/librewolf/chrome/"
mkdir -p "$D/startpage" && cp "$C"/graphite-startpage/* "$D/startpage/"
mkdir -p "$D/brave/graphite-theme" && cp "$C/brave-origin-flags.conf" "$D/brave/" && cp "$C/BraveSoftware/graphite-theme/manifest.json" "$D/brave/graphite-theme/"

git -C "$D" status --short
