#!/usr/bin/env bash

THEME="$HOME/.config/rofi/arch-gray.rasi"

menu() {  # menu <prompt> <lines>   (items on stdin)
    rofi -dmenu -i -p "$1" -theme "$THEME" -theme-str "listview { lines: $2; }"
}

opcion=$(printf '%s\n' \
  "Lock" \
  "Log Out" \
  "Reboot" \
  "Power Off" |
  menu "System" 4)

confirmar() {
    respuesta=$(printf '%s\n' "No" "Yes" | menu "$1" 2)
    [[ "$respuesta" == "Yes" ]]
}

case "$opcion" in
    "Lock")
        i3lock -c 181818
        ;;
    "Log Out")
        confirmar "Log Out?" && i3-msg exit
        ;;
    "Reboot")
        confirmar "Reboot?" && systemctl reboot
        ;;
    "Power Off")
        confirmar "Power Off?" && systemctl poweroff
        ;;
esac
