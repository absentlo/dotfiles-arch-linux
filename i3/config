# i3 config (v4) - Graphite, low-spec build
set $mod Mod4

# ---------- APPEARANCE ----------
font pango:JetBrainsMono Nerd Font, FontAwesome 8
default_border pixel 2
smart_borders on
default_floating_border pixel 0
hide_edge_borders none
for_window [all] border pixel 2
title_align center
for_window [all] title_window_icon padding 4
gaps inner 8
gaps outer 4

# class                 border  backgr. text    indicator child_border
client.focused          #888888 #111111 #FFFFFF #888888   #888888
client.focused_inactive #111111 #111111 #888888 #111111   #111111
client.unfocused        #111111 #111111 #555555 #111111   #111111
client.urgent           #5A2A2A #3A1A1A #FFFFFF #5A2A2A   #5A2A2A
client.placeholder      #111111 #111111 #888888 #111111   #111111
client.background       #111111

# ---------- BEHAVIOR ----------
focus_on_window_activation smart
popup_during_fullscreen smart
workspace_auto_back_and_forth yes
floating_minimum_size 300 x 200
floating_maximum_size -1 x -1
floating_modifier $mod
tiling_drag modifier titlebar

# ---------- WORKSPACES ----------
set $ws1 "1:"
set $ws2 "2:"
set $ws3 "3:"
set $ws4 "4:"
set $ws5 "5:󰭹"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ---------- AUTOSTART (no dex: nothing hidden starts) ----------
exec --no-startup-id xset r rate 300 40
exec --no-startup-id sh ~/.fehbg
exec --no-startup-id sh -c 'pgrep -x picom >/dev/null || picom -b'
exec --no-startup-id sh -c 'pgrep -x dunst >/dev/null || dunst'
exec --no-startup-id sh -c 'pgrep -x lxqt-policykit-agent >/dev/null || lxqt-policykit-agent'
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -i ~/.local/share/i3lock/lock.png -c 111111 --nofork
exec_always --no-startup-id sh -c '(pkill -x alttab || true) && sleep 0.3 && exec alttab -fg "#D8D8D8" -bg "#111111" -frame "#3A3A3A" -t 128x128 -i 32x32'
exec_always --no-startup-id ~/.config/polybar/launch.sh
# Split each new window along the focused window's longer side (dwindle-style)
exec_always --no-startup-id sh -c 'pgrep -x autotiling >/dev/null || exec autotiling'
bindsym $mod+t exec --no-startup-id sh -c 'pkill -x autotiling && notify-send -t 1500 Autotiling Off || (setsid -f autotiling && notify-send -t 1500 Autotiling On)'
# Manual extras (uncomment if needed):
#exec --no-startup-id nm-applet
#exec --no-startup-id blueman-applet

# ---------- KEYBINDINGS ----------
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+d exec --no-startup-id rofi -show drun -show-icons -theme ~/.config/rofi/arch-gray.rasi
bindsym $mod+Shift+q kill

# focus: j k l ;  (left down up right)
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Tab workspace back_and_forth

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This ends your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# lock moved to $mod+x (so $mod+l can be focus up)
bindsym $mod+x exec --no-startup-id i3lock -i ~/.local/share/i3lock/lock.png -c 111111
bindsym $mod+Shift+p exec --no-startup-id ~/.local/bin/i3-power-menu
bindsym $mod+Shift+b exec --no-startup-id gtk-launch brave-origin.desktop
bindsym $mod+Shift+f exec --no-startup-id thunar
bindsym Print exec --no-startup-id xfce4-screenshooter -f
bindsym $mod+Shift+s exec --no-startup-id xfce4-screenshooter

# volume: one script for keys, bar and popups
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/i3-volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/i3-volume down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/i3-volume mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym $mod+Mod1+Up exec --no-startup-id ~/.local/bin/i3-volume up
bindsym $mod+Mod1+Down exec --no-startup-id ~/.local/bin/i3-volume down
bindsym $mod+Mod1+m exec --no-startup-id ~/.local/bin/i3-volume mute

bindsym $mod+Shift+h exec --no-startup-id ~/.local/bin/i3-shortcuts
bindsym $mod+c exec --no-startup-id ~/.local/bin/i3-calendar
bindsym $mod+m exec --no-startup-id ~/.local/bin/i3-media popup
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ---------- WINDOW RULES ----------
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_role="About"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="utility"] floating enable
for_window [class="(?i)Gsimplecal"] floating enable, border pixel 0, move position center

for_window [title="^Picture-in-Picture$"] floating enable, sticky enable
for_window [title="^Picture in picture$"] floating enable, sticky enable
for_window [title="^Open File$"] floating enable, resize set 900 600, move position center
for_window [title="^Save As$"] floating enable, resize set 900 600, move position center

for_window [class="(?i)Thunar" title="^File Operation Progress$"] floating enable, move position center
for_window [class="(?i)^Pavucontrol$"] floating enable, resize set 780 500, move position center
for_window [class="(?i)Blueman-manager"] floating enable, resize set 600 400, move position center
for_window [class="(?i)Nm-connection-editor"] floating enable, resize set 600 400, move position center
for_window [class="(?i)Xfce4-screenshooter"] floating enable, move position center

exec --no-startup-id xset s off

# rice-v3: popups instead of resident tray applets (nm-applet + blueman, ~190 MB)
bindsym $mod+n exec --no-startup-id ~/.local/bin/i3-wifi
bindsym $mod+b exec --no-startup-id ~/.local/bin/i3-bluetooth popup

# Scratchpad terminal: Win+` shows/hides it, starts it on first use
for_window [window_role="^scratchpad$"] floating enable, resize set 1000 450, move scratchpad, scratchpad show
bindsym $mod+grave exec --no-startup-id sh -c 'i3-msg "[window_role=^scratchpad$] scratchpad show" | grep -q true || xfce4-terminal --role=scratchpad'
