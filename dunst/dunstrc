# Dunst Graphite - Arch + i3  (rice-v2: icons, unified font)

[global]
    monitor = 0
    follow = none

    width = 300
    height = (0, 160)
    origin = top-right
    offset = (12, 34)

    font = JetBrainsMono Nerd Font 8
    frame_width = 1
    frame_color = "#3A3A3A"
    corner_radius = 8
    transparency = 0

    padding = 10
    horizontal_padding = 12
    separator_height = 1
    separator_color = frame

    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    show_indicators = no

    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    # Left click runs the notification's action (e.g. open a screenshot), then closes it
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all
    icon_theme = "Papirus-Dark-Graphite, Papirus-Dark, Adwaita"
    enable_recursive_icon_lookup = true

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 250
    progress_bar_corner_radius = 3
    highlight = "#B8B8B8"

    notification_limit = 4
    sort = yes
    stack_duplicates = true

[urgency_low]
    background = "#1C1C1C"
    foreground = "#9A9A9A"
    timeout = 3

[urgency_normal]
    background = "#1C1C1C"
    foreground = "#D8D8D8"
    timeout = 5

[urgency_critical]
    background = "#1C1C1C"
    foreground = "#FFFFFF"
    frame_color = "#C46A6A"
    timeout = 0

# Screenshot previews: a real thumbnail instead of a 32px icon
[screenshot]
    appname = Screenshot
    min_icon_size = 96
    max_icon_size = 160
