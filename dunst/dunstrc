# Dunst Graphite Rice - Arch Linux + i3wm

[global]
    monitor = 0
    follow = none

    # Posición y dimensiones
    width = 280
    height = (0, 160)
    origin = top-right
    offset = (12, 35)

    # Estética y tipografía (Sincronizada a tamaño 7)
    font = DejaVu Sans 7
    frame_width = 1
    frame_color = "#393939"
    corner_radius = 4
    transparency = 0

    # Espaciado
    padding = 8
    horizontal_padding = 10
    separator_height = 1
    separator_color = frame

    # Formato de texto
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    show_indicators = no

    # Barra de progreso (para volumen/brillo)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 250
    progress_bar_corner_radius = 2

    # Comportamiento
    notification_limit = 4
    sort = yes
    stack_duplicates = true

[urgency_low]
    background = "#181818"
    foreground = "#AAAAAA"
    timeout = 3

[urgency_normal]
    background = "#181818"
    foreground = "#E4E4E4"
    timeout = 5

[urgency_critical]
    background = "#2A1818"
    foreground = "#FFFFFF"
    frame_color = "#5A2A2A"
    timeout = 0