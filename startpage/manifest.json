{
  "manifest_version": 3,
  "name": "Graphite Start",
  "version": "0.5.4",
  "description": "Graphite rice new tab: clock, search, pages, weather, wallpaper. No background code.",
  "permissions": ["storage", "unlimitedStorage"],
  "optional_permissions": ["topSites"],
  "optional_host_permissions": ["https://icons.duckduckgo.com/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "graphite-start@rice.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["locationInfo", "browsingActivity"]
      }
    }
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  }
}
