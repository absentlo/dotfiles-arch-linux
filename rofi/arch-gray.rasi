/* Minimalist Graphite Rofi Theme */

* {
    font: "DejaVu Sans 8";
    background-color: transparent;
    text-color: #D8D8D8;
    margin: 0;
    padding: 0;
}

window {
    width: 400px;
    background-color: #111111;
    border: 1px;
    border-color: #3A3A3A;
    border-radius: 4px;
    padding: 12px;
}

mainbox {
    spacing: 12px;
}

inputbar {
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #9A9A9A;
}

entry {
    placeholder: "Search...";
    placeholder-color: #4A4A4A;
}

listview {
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 6px;
    border-radius: 2px;
}

element selected {
    background-color: #2F2F2F;
    text-color: #FFFFFF;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 16px;
    padding: 0 8px 0 0;
}